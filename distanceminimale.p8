pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- distance min
cls()
dmin=30
dmax=128-dmin
--print(dmin)
--print(dmax)
while true 
do
hazard=rnd(dmax-dmin)+dmin
--print(hazard)
angle=rnd(1)
x=flr((60+(cos(angle)*hazard))%128)
y=flr((60+(hazard*sin(angle)))%128)
--print(x)
--print(y)
spr(0,x,y)
tps=t()
while (t()<tps+0.1)
do

end
end

